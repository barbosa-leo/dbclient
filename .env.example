# Chave AES-256 de 32 bytes em base64 (obrigatória). Gere com: openssl rand -base64 32
DBCLIENT_ENCRYPTION_KEY=

# Configurações opcionais
DBCLIENT_PORT_APP=8080
DBCLIENT_INITIAL_ADMIN_PASSWORD=admin
DBCLIENT_DUMP_TTL=24h
DBCLIENT_SESSION_TTL=12h

# Rate Limiting & Proxy
DBCLIENT_TRUSTED_PROXIES=
DBCLIENT_RATE_LIMIT_ENABLED=true
DBCLIENT_RATE_LIMIT_QUERY=60
DBCLIENT_RATE_LIMIT_API=120
DBCLIENT_RATE_LIMIT_AUTH=10
